{
  "collections": [
    {
      "name": "{prefix}listings",
      "indexes": [
        { "keys": { "seller": 1, "status": 1 } },
        { "keys": { "currentBidder": 1, "status": 1 } },
        { "keys": { "status": 1, "listingType": 1 } },
        { "keys": { "status": 1, "expiresAt": 1 } },
        { "keys": { "status": 1, "endedAt": 1 } },
        { "keys": { "category": 1 } },
        { "keys": { "economy": 1 } },
        { "keys": { "searchName": 1 } }
      ]
    },
    {
      "name": "{prefix}history",
      "indexes": [
        { "keys": { "seller": 1, "completedAt": -1 } },
        { "keys": { "buyer": 1, "completedAt": -1 } },
        { "keys": { "category": 1 } },
        { "keys": { "economy": 1 } },
        { "keys": { "searchName": 1 } },
        { "keys": { "sortPrice": 1 } }
      ]
    },
    {
      "name": "{prefix}players",
      "indexes": [
        {
          "keys": { "name": 1 },
          "options": { "unique": true, "collation": { "locale": "en", "strength": 2 } }
        }
      ]
    }
  ]
}